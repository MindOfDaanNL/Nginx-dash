<div class="page-header">
  <div style="display:flex; align-items:center; justify-content:space-between;">
    <div>
      <h1 class="page-title">Gebruikersbeheer</h1>
      <p class="page-subtitle">Beheer applicatiegebruikers en rollen.</p>
    </div>
    <button class="btn btn-primary" onclick="openUserModal()">Gebruiker toevoegen</button>
  </div>
</div>

<div class="section">
  <div class="table-wrap">
    <table id="users-table">
      <thead>
        <tr><th>Gebruikersnaam</th><th>E-mail</th><th>Rol</th><th>Actief</th><th>Laatste login</th><th>Aangemaakt</th><th>Acties</th></tr>
      </thead>
      <tbody id="users-tbody"><tr><td colspan="7" class="empty" style="padding:24px">Laden…</td></tr></tbody>
    </table>
  </div>
</div>

<!-- User modal -->
<div class="modal-overlay" id="user-modal">
  <div class="modal" style="max-width:640px;">
    <div class="modal-header"><span class="modal-title" id="user-modal-title">Gebruiker toevoegen</span><button class="close-btn" onclick="closeUserModal()">&times;</button></div>
    <div class="modal-body">
      <form id="user-form" novalidate>
        <input type="hidden" name="id">
        <div class="form-grid">
          <div class="field">
            <label>Gebruikersnaam</label>
            <input type="text" name="username" required>
          </div>
          <div class="field">
            <label>E-mail</label>
            <input type="email" name="email">
          </div>
          <div class="field">
            <label>Wachtwoord</label>
            <input type="password" name="password" id="user-password" placeholder="Laat leeg om ongewijzigd te laten">
          </div>
          <div class="field">
            <label>Rol</label>
            <select name="role">
              <option value="viewer">Viewer (alleen lezen)</option>
              <option value="admin">Administrator</option>
            </select>
          </div>
          <div class="field">
            <label class="checkbox-label" style="display:flex;align-items:center;gap:8px;">
              <input type="checkbox" name="is_active" checked> Account actief
            </label>
          </div>
        </div>
        <div id="user-err" style="color:var(--danger); font-size:12px; margin-top:10px; display:none;"></div>
      </form>
    </div>
    <div class="modal-footer">
      <button class="btn btn-outline" onclick="closeUserModal()">Annuleren</button>
      <button class="btn btn-primary" id="user-submit">Opslaan</button>
    </div>
  </div>
</div>

<script>
const userModal = document.getElementById('user-modal');
let editId = null;

function openUserModal(id) {
  editId = id;
  const form = document.getElementById('user-form');
  form.reset();
  document.getElementById('user-modal-title').textContent = id ? 'Gebruiker bewerken' : 'Gebruiker toevoegen';
  document.getElementById('user-password').required = !id;
  document.getElementById('user-err').style.display = 'none';
  userModal.classList.add('open');
  if (id) loadUser(id);
}
function closeUserModal() { userModal.classList.remove('open'); }
window.addEventListener('click', (e) => { if (e.target === userModal) closeUserModal(); });

async function loadUsers() {
  const tbody = document.getElementById('users-tbody');
  tbody.innerHTML = '<tr><td colspan="7" class="empty" style="padding:24px">Laden…</td></tr>';
  try {
    const { users } = await apiRequest('/users');
    tbody.innerHTML = users.map(u => `
      <tr>
        <td><strong>${u.username}</strong></td>
        <td>${u.email || '—'}</td>
        <td><span class="badge ${u.role === 'admin' ? 'badge-danger' : 'badge-neutral'}">${u.role}</span></td>
        <td><span class="badge ${u.is_active ? 'badge-success' : 'badge-danger'}">${u.is_active ? 'Actief' : 'Inactief'}</span></td>
        <td>${formatDate(u.last_login)}</td>
        <td>${formatDate(u.created_at)}</td>
        <td>
          <button class="btn btn-sm btn-outline" onclick="openUserModal(${u.id})">Bewerken</button>
          <button class="btn btn-sm btn-outline" onclick="resetPassword(${u.id})">Wachtwoord resetten</button>
          <button class="btn btn-sm btn-danger" onclick="removeUser(${u.id}, '${u.username.replace(/'/g, "\\'")}')">Verwijderen</button>
        </td>
      </tr>
    `).join('') || '<tr><td colspan="7" class="empty" style="padding:24px">Geen gebruikers.</td></tr>';
  } catch (e) {
    tbody.innerHTML = `<tr><td colspan="7" class="empty" style="padding:24px">Fout: ${e.message}</td></tr>`;
  }
}

async function loadUser(id) {
  try {
    // find from list is not available; fetch via endpoint not exposed single, so just show blank for edit
    // We'll rely on the admin knowing values; prefill not critical
  } catch (e) {}
}

document.getElementById('user-form').addEventListener('submit', async (e) => {
  e.preventDefault();
  const form = e.target;
  const btn = document.getElementById('user-submit');
  const err = document.getElementById('user-err');
  btn.disabled = true; btn.textContent = 'Opslaan…';
  const body = {
    username: form.username.value,
    email: form.email.value,
    role: form.role.value,
    is_active: form.is_active.checked ? 1 : 0,
  };
  if (form.password.value) body.password = form.password.value;
  try {
    if (editId) {
      await apiRequest(`/users/${editId}`, { method: 'PUT', body: JSON.stringify(body) });
    } else {
      await apiRequest('/users', { method: 'POST', body: JSON.stringify(body) });
    }
    closeUserModal();
    loadUsers();
  } catch (errObj) {
    err.textContent = errObj.data?.error || errObj.message || 'Mislukt';
    err.style.display = 'block';
  } finally {
    btn.disabled = false; btn.textContent = 'Opslaan';
  }
});

async function resetPassword(id) {
  const pw = prompt('Nieuw wachtwoord voor gebruiker:');
  if (!pw) return;
  try {
    await apiRequest(`/users/${id}/reset-password`, { method: 'POST', body: JSON.stringify({ password: pw }) });
    alert('Wachtwoord gereset.');
  } catch (e) {
    alert('Mislukt: ' + e.message);
  }
}

async function removeUser(id, name) {
  if (!confirm(`Gebruiker "${name}" verwijderen?`)) return;
  try {
    await apiRequest(`/users/${id}`, { method: 'DELETE' });
    loadUsers();
  } catch (e) {
    alert('Mislukt: ' + e.message);
  }
}

loadUsers();
</script>
