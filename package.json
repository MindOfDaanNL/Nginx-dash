{
  "name": "nginx-dash",
  "version": "1.0.0",
  "description": "Self-hosted Nginx Management Dashboard",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node src/server.js",
    "migrate": "node scripts/run-migrations.js",
    "seed": "node scripts/seed.js",
    "lint": "npx eslint src/ nginx-helper/ scripts/ --ext .js",
    "test": "node --test tests/**/*.test.js"
  },
  "keywords": [
    "nginx",
    "dashboard",
    "ssl",
    "certbot",
    "self-hosted"
  ],
  "author": "Nginx-Dash",
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "connect-flash": "^0.1.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "helmet": "^7.1.0",
    "mysql2": "^3.9.7",
    "zod": "^3.23.8",
    "ejs": "^3.1.10"
  },
  "devDependencies": {
    "eslint": "^8.57.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
